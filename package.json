{
  "name": "freecopilot",
  "displayName": "FreeCopilot",
  "description": "A free AI assistant with project mapping and asset uploading.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "free-copilot-sidebar",
          "title": "Free Copilot",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "free-copilot-sidebar": [
        {
          "type": "webview",
          "id": "freeCopilot.chatView",
          "name": "Chat Assistant",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "freeCopilot.generateProjectMap",
        "title": "Free Copilot: Generate Project Structure Map",
        "category": "Free Copilot"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
