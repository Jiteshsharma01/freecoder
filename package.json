{
  "name": "freecoder",
  "displayName": "freecoder",
  "description": "A free AI assistant with project mapping and asset uploading.",
  "version": "0.0.4",
  "publisher": "local-itui",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "free-coder-sidebar",
          "title": "Free Coder",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "free-coder-sidebar": [
        {
          "type": "webview",
          "id": "freecoder.chatView",
          "name": "Chat Assistant",
          "icon": ""
        }
      ]
    },
    "commands": [
      {
        "command": "freecoder.generateProjectMap",
        "title": "Free Coder: Generate Project Structure Map",
        "category": "Free Coder"
      },
      {
        "command": "freecoder.generateKnowledgeGraph",
        "title": "Free Coder: Generate Knowledge Graph",
        "category": "Free Coder"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
